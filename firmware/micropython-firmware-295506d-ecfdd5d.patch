Subject: [PATCH 6/8] prevent broadcast + multicast bit

---
 ports/esp8266/modespnow.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/ports/esp8266/modespnow.c b/ports/esp8266/modespnow.c
index e7bdbba73..6edca83d0 100644
--- a/ports/esp8266/modespnow.c
+++ b/ports/esp8266/modespnow.c
@@ -433,9 +433,23 @@ static MP_DEFINE_CONST_FUN_OBJ_2(espnow_set_pmk_obj, espnow_set_pmk);
 // Raise TypeError if invalid keyword args or too many positional args.
 // Return None.
 static mp_obj_t espnow_add_peer(size_t n_args, const mp_obj_t *args) {
+    // Get the peer MAC address
+    uint8_t *peer_mac = _get_bytes_len(args[1], ESP_NOW_ETH_ALEN);
+    
+    // Check if this is a broadcast address (FF:FF:FF:FF:FF:FF)
+    if (peer_mac[0] == 0xFF && peer_mac[1] == 0xFF && peer_mac[2] == 0xFF && 
+        peer_mac[3] == 0xFF && peer_mac[4] == 0xFF && peer_mac[5] == 0xFF) {
+        mp_raise_ValueError(MP_ERROR_TEXT("CTC 2025 - Broadcast MAC address is not allowed. Do NOT broadcast during this CTF."));
+    }
+    
+    // Check if the first bit (LSB) of the first byte is set (multicast/broadcast bit)
+    if (peer_mac[0] & 0x01) {
+        mp_raise_ValueError(MP_ERROR_TEXT("Invalid peer MAC address."));
+    }
+
     check_esp_err(
         esp_now_add_peer(
-            _get_bytes_len(args[1], ESP_NOW_ETH_ALEN),
+            peer_mac,
             ESP_NOW_ROLE_COMBO,
             (n_args > 3) ? mp_obj_get_int(args[3]) : 0,
             (n_args > 2) ? _get_bytes_len(args[2], ESP_NOW_KEY_LEN) : NULL,
